# Анализ характеристик кластеров KMeans
print(f"\nАНАЛИЗ КЛАСТЕРОВ KMEANS ({optimal_k} кластеров):")
print("-" * 60)

# Добавляем исходные значения (до нормализации) для интерпретации
X_original = pd.DataFrame(scaler.inverse_transform(X_scaled), columns=X.columns)

for cluster_id in range(optimal_k):
    cluster_mask = kmeans_labels == cluster_id
    cluster_size = np.sum(cluster_mask)
    
    if cluster_size > 0:
        print(f"\nКластер {cluster_id}:")
        print(f"  Размер: {cluster_size} объектов ({cluster_size/len(kmeans_labels)*100:.1f}%)")
        
        # Средние значения признаков в кластере
        cluster_means = X_original[cluster_mask].mean()
        
        print(f"  Средние значения признаков:")
        print(f"    Полезность отзыва: {cluster_means.get(col_useful, 0):.1f}")
        print(f"    Длина отзыва (символы): {cluster_means.get('review_len_char', 0):.0f}")
        print(f"    Длина отзыва (слова): {cluster_means.get('review_len_word', 0):.0f}")
        print(f"    Сентимент: {cluster_means.get('sentiment', 0):.2f}")
        
        # Распределение рейтингов в кластере
        cluster_ratings = df_clean.loc[cluster_mask, col_rating]
        print(f"  Средний рейтинг в кластере: {cluster_ratings.mean():.2f}")
        
        # Топ лекарств в кластере
        if col_drug in df_clean.columns:
            top_drugs = df_clean.loc[cluster_mask, col_drug].value_counts().head(3)
            if len(top_drugs) > 0:
                print(f"  Топ лекарств: {', '.join([f'{drug} ({count})' for drug, count in top_drugs.items()])}")
        
        # Топ состояний в кластере
        if col_condition in df_clean.columns:
            top_conditions = df_clean.loc[cluster_mask, col_condition].value_counts().head(3)
            if len(top_conditions) > 0:
                print(f"  Топ состояний: {', '.join([f'{cond} ({count})' for cond, count in top_conditions.items()])}")

# ============================================================================
# 8. СРАВНИТЕЛЬНЫЙ АНАЛИЗ РЕЗУЛЬТАТОВ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 8: СРАВНИТЕЛЬНЫЙ АНАЛИЗ РЕЗУЛЬТАТОВ")
print("="*80)

# Сравнение согласованности методов
print("\nСОГЛАСОВАННОСТЬ РЕЗУЛЬТАТОВ РАЗНЫХ МЕТОДОВ:")
print("-" * 60)

# Создаем таблицу сопряженности для KMeans и Agglomerative
contingency_table = pd.crosstab(kmeans_labels, agglomerative_labels)
print("\nТаблица сопряженности (KMeans vs Agglomerative):")
print(contingency_table)

# Вычисляем степень согласованности
total_agreement = 0
for kmeans_cluster in range(optimal_k):
    if kmeans_cluster in contingency_table.index:
        max_in_row = contingency_table.loc[kmeans_cluster].max()
        total_in_row = contingency_table.loc[kmeans_cluster].sum()
        agreement_percent = max_in_row / total_in_row * 100 if total_in_row > 0 else 0
        total_agreement += max_in_row
        
        corresponding_agg_cluster = contingency_table.loc[kmeans_cluster].idxmax()
        print(f"Кластер {kmeans_cluster} (KMeans): {agreement_percent:.1f}% соответствует кластеру {corresponding_agg_cluster} (Agglomerative)")

overall_agreement = total_agreement / len(kmeans_labels) * 100
print(f"\nОбщая согласованность методов: {overall_agreement:.1f}%")

# Визуализация распределения классов рейтинга по кластерам KMeans
print("\nРАСПРЕДЕЛЕНИЕ КЛАССОВ РЕЙТИНГА ПО КЛАСТЕРАМ KMEANS:")
print("-" * 60)

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Столбчатая диаграмма
cluster_rating_dist = pd.crosstab(df_clean['KMeans_Cluster'], df_clean['rating_class'])
cluster_rating_dist.plot(kind='bar', ax=axes[0])
axes[0].set_xlabel('Кластер KMeans')
axes[0].set_ylabel('Количество объектов')
axes[0].set_title('Распределение классов рейтинга по кластерам')
axes[0].legend(title='Класс рейтинга')
axes[0].grid(True, alpha=0.3)

# Нормализованная тепловая карта
cluster_rating_norm = cluster_rating_dist.div(cluster_rating_dist.sum(axis=1), axis=0)
sns.heatmap(cluster_rating_norm, annot=True, fmt='.2f', cmap='YlOrRd', ax=axes[1])
axes[1].set_xlabel('Класс рейтинга')
axes[1].set_ylabel('Кластер KMeans')
axes[1].set_title('Доля классов рейтинга в кластерах (нормализованная)')

plt.tight_layout()
plt.show()

