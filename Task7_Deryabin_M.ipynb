import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans, DBSCAN, AgglomerativeClustering
from sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score
from sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score
from sklearn.neighbors import NearestNeighbors
import scipy.cluster.hierarchy as sch
from datasets import load_dataset
import plotly.express as px
import plotly.graph_objects as go
from plotly.subplots import make_subplots

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

# ============================================================================
# 1. ЗАГРУЗКА И ПРЕДВАРИТЕЛЬНАЯ ОБРАБОТКА ДАННЫХ
# ============================================================================

print("="*80)
print("ЭТАП 1: ЗАГРУЗКА И ПРЕДВАРИТЕЛЬНАЯ ОБРАБОТКА ДАННЫХ")
print("="*80)

# Загрузка данных
print("Загружаем данные с Hugging Face...")
try:
    ds = load_dataset("forwins/Drug-Review-Dataset", split="train")
except Exception as e:
    try:
        ds = load_dataset("forwins/Drug-Review-Dataset")["train"]
    except Exception as e2:
        raise RuntimeError(f"Не удалось загрузить датасет: {e}\n{e2}")

df = ds.to_pandas()
print(f"Размер датасета: {df.shape}")

# Унификация имен столбцов
cols_lower = {c: c.lower() for c in df.columns}
df = df.rename(columns=cols_lower)

# Определение столбцов
def find_col(cands):
    for c in cands:
        if c in df.columns:
            return c
    return None

col_rating = find_col(["rating", "score", "stars"])
col_review = find_col(["review", "text", "content", "reviews"])
col_drug = find_col(["drugname", "drug_name", "drug", "medicine"])
col_condition = find_col(["condition", "diagnosis", "disease"])
col_useful = find_col(["usefulcount", "helpful", "helpful_count", "useful_count"])
col_date = find_col(["date", "review_date", "time"])

print(f"\nОпределенные столбцы:")
print(f"Рейтинг: {col_rating}")
print(f"Отзыв: {col_review}")
print(f"Лекарство: {col_drug}")
print(f"Состояние: {col_condition}")
print(f"Полезность: {col_useful}")
print(f"Дата: {col_date}")

# Создание признаков из данных
df_clean = df.copy()

# Обработка даты
if col_date in df_clean.columns:
    df_clean['_date_parsed'] = pd.to_datetime(df_clean[col_date], errors='coerce')
    df_clean['year'] = df_clean['_date_parsed'].dt.year
    df_clean['month'] = df_clean['_date_parsed'].dt.month
    df_clean['day_of_week'] = df_clean['_date_parsed'].dt.dayofweek
else:
    df_clean['year'] = 2015  # среднее значение
    df_clean['month'] = 6
    df_clean['day_of_week'] = 3

# Признаки из текста
df_clean['review_len_char'] = df_clean[col_review].fillna('').astype(str).apply(len)
df_clean['review_len_word'] = df_clean[col_review].fillna('').astype(str).apply(lambda s: len(s.split()))

# Сентимент анализ (упрощенный)
def simple_sentiment(text):
    text = str(text).lower()
    positive_words = ['good', 'great', 'excellent', 'effective', 'helpful', 'improved', 'better', 'relief']
    negative_words = ['bad', 'terrible', 'worse', 'ineffective', 'side', 'pain', 'horrible', 'awful']
    
    pos_count = sum(1 for word in positive_words if word in text)
    neg_count = sum(1 for word in negative_words if word in text)
    
    if pos_count > neg_count:
        return 1  # положительный
    elif neg_count > pos_count:
        return -1  # отрицательный
    else:
        return 0  # нейтральный

df_clean['sentiment'] = df_clean[col_review].apply(simple_sentiment)

# Обработка пропущенных значений
numeric_cols = [col_useful, 'review_len_char', 'review_len_word', 'year', 'month', 'day_of_week']
for col in numeric_cols:
    if col in df_clean.columns:
        df_clean[col] = pd.to_numeric(df_clean[col], errors='coerce')
        df_clean[col] = df_clean[col].fillna(df_clean[col].median())

# Категориальные переменные для анализа
categorical_cols = []
if col_drug in df_clean.columns:
    df_clean[col_drug] = df_clean[col_drug].fillna('Unknown')
    categorical_cols.append(col_drug)
if col_condition in df_clean.columns:
    df_clean[col_condition] = df_clean[col_condition].fillna('Unknown')
    categorical_cols.append(col_condition)

# Целевая переменная для последующего сравнения (преобразуем рейтинг в классы)
df_clean['rating_class'] = pd.cut(df_clean[col_rating], 
                                   bins=[0, 4, 7, 10], 
                                   labels=['Low', 'Medium', 'High'])
le = LabelEncoder()
df_clean['rating_class_encoded'] = le.fit_transform(df_clean['rating_class'])

print(f"\nКлассы рейтинга:")
print(df_clean['rating_class'].value_counts())

# ============================================================================
# 2. ПОДГОТОВКА ПРИЗНАКОВ ДЛЯ КЛАСТЕРИЗАЦИИ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 2: ПОДГОТОВКА ПРИЗНАКОВ ДЛЯ КЛАСТЕРИЗАЦИИ")
print("="*80)

# Выбор признаков для кластеризации
features_for_clustering = [
    col_useful, 'review_len_char', 'review_len_word', 
    'year', 'month', 'day_of_week', 'sentiment'
]

# Удаляем отсутствующие столбцы
features_for_clustering = [f for f in features_for_clustering if f in df_clean.columns]

print(f"Используемые признаки для кластеризации ({len(features_for_clustering)}):")
for i, feat in enumerate(features_for_clustering, 1):
    print(f"{i:2}. {feat}")

# Создание матрицы признаков
X = df_clean[features_for_clustering].copy()

# Нормализация данных
scaler = StandardScaler()
X_scaled = pd.DataFrame(scaler.fit_transform(X), columns=X.columns)

print(f"\nРазмерность данных для кластеризации: {X_scaled.shape}")
print("\nСтатистики после нормализации:")
print(X_scaled.describe().round(2))

# ============================================================================
# 3. ОПРЕДЕЛЕНИЕ ОПТИМАЛЬНОГО ЧИСЛА КЛАСТЕРОВ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 3: ОПРЕДЕЛЕНИЕ ОПТИМАЛЬНОГО ЧИСЛА КЛАСТЕРОВ")
print("="*80)

# Метод локтя для KMeans
inertia = []
silhouette_scores = []
K_range = range(2, 15)

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=RANDOM_STATE, n_init=10)
    kmeans.fit(X_scaled)
    inertia.append(kmeans.inertia_)
    silhouette_avg = silhouette_score(X_scaled, kmeans.labels_)
    silhouette_scores.append(silhouette_avg)

# Графики для определения оптимального k
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

# Метод локтя
ax1.plot(K_range, inertia, 'bo-')
ax1.set_xlabel('Количество кластеров (k)')
ax1.set_ylabel('Инерция')
ax1.set_title('Метод локтя для KMeans')
ax1.grid(True, alpha=0.3)

# Силуэтный коэффициент
ax2.plot(K_range, silhouette_scores, 'ro-')
ax2.set_xlabel('Количество кластеров (k)')
ax2.set_ylabel('Средний силуэтный коэффициент')
ax2.set_title('Силуэтный анализ')
ax2.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

# Определение оптимального k
optimal_k_silhouette = K_range[np.argmax(silhouette_scores)]
print(f"Оптимальное число кластеров по силуэтному коэффициенту: {optimal_k_silhouette}")
optimal_k = optimal_k_silhouette

# ============================================================================
# 4. ПРИМЕНЕНИЕ МЕТОДОВ КЛАСТЕРИЗАЦИИ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 4: ПРИМЕНЕНИЕ МЕТОДОВ КЛАСТЕРИЗАЦИИ")
print("="*80)

# 4.1. PCA для визуализации
pca_2d = PCA(n_components=2, random_state=RANDOM_STATE)
X_pca_2d = pca_2d.fit_transform(X_scaled)

pca_3d = PCA(n_components=3, random_state=RANDOM_STATE)
X_pca_3d = pca_3d.fit_transform(X_scaled)

print(f"Объясненная дисперсия (2 компоненты): {pca_2d.explained_variance_ratio_.sum():.2%}")
print(f"Объясненная дисперсия (3 компоненты): {pca_3d.explained_variance_ratio_.sum():.2%}")

# 4.2. Метод 1: KMeans
print("\n1. Применение KMeans кластеризации...")
kmeans = KMeans(n_clusters=optimal_k, random_state=RANDOM_STATE, n_init=20)
kmeans_labels = kmeans.fit_predict(X_scaled)
df_clean['KMeans_Cluster'] = kmeans_labels

# 4.3. Метод 2: DBSCAN
print("2. Применение DBSCAN кластеризации...")

# Определение оптимального eps для DBSCAN
def find_optimal_eps(data, min_samples, percentile=95):
    """Определение оптимального параметра eps для DBSCAN"""
    neighbors = NearestNeighbors(n_neighbors=min_samples)
    neighbors_fit = neighbors.fit(data)
    distances, indices = neighbors_fit.kneighbors(data)
    k_distances = np.sort(distances[:, min_samples-1])
    eps_value = np.percentile(k_distances, percentile)
    return eps_value, k_distances

min_samples_dbscan = 10
optimal_eps, k_distances = find_optimal_eps(X_scaled, min_samples_dbscan, percentile=90)
print(f"   Автоматически выбранное значение eps: {optimal_eps:.3f}")

# График k-расстояний
plt.figure(figsize=(10, 6))
plt.plot(k_distances)
plt.axhline(y=optimal_eps, color='r', linestyle='--', label=f'eps = {optimal_eps:.3f}')
plt.xlabel('Объекты (отсортированные)')
plt.ylabel(f'Дистанция до {min_samples_dbscan}-го соседа')
plt.title('График k-расстояний для настройки DBSCAN')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Применение DBSCAN
dbscan = DBSCAN(eps=optimal_eps, min_samples=min_samples_dbscan, metric='euclidean')
dbscan_labels = dbscan.fit_predict(X_scaled)
df_clean['DBSCAN_Cluster'] = dbscan_labels

# 4.4. Метод 3: Агломеративная (иерархическая) кластеризация
print("3. Применение агломеративной кластеризации...")
agglomerative = AgglomerativeClustering(n_clusters=optimal_k, linkage='ward')
agglomerative_labels = agglomerative.fit_predict(X_scaled)
df_clean['Agglomerative_Cluster'] = agglomerative_labels

# Построение дендрограммы (на выборке)
print("   Построение дендрограммы...")
sample_size = min(100, len(X_scaled))
sample_indices = np.random.choice(len(X_scaled), sample_size, replace=False)
X_sample = X_scaled.iloc[sample_indices].values

plt.figure(figsize=(12, 6))
dendrogram = sch.dendrogram(sch.linkage(X_sample, method='ward'),
                            truncate_mode='level', p=5)
plt.title(f'Дендрограмма агломеративной кластеризации\n(выборка из {sample_size} объектов)')
plt.xlabel('Объекты выборки')
plt.ylabel('Евклидово расстояние')
plt.axhline(y=8, color='r', linestyle='--', label=f'Разделение на {optimal_k} кластеров')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Статистика по кластерам
print("\nСТАТИСТИКА ПОЛУЧЕННЫХ КЛАСТЕРОВ:")
print("-" * 60)
print(f"KMeans:            {len(np.unique(kmeans_labels))} кластеров")

dbscan_unique = np.unique(dbscan_labels)
dbscan_clusters = len(dbscan_unique) - (1 if -1 in dbscan_unique else 0)
noise_points = np.sum(dbscan_labels == -1)
print(f"DBSCAN:            {dbscan_clusters} кластеров ({noise_points} шумовых точек, {noise_points/len(dbscan_labels)*100:.1f}%)")

print(f"Agglomerative:     {len(np.unique(agglomerative_labels))} кластеров")

# ============================================================================
# 5. ВИЗУАЛИЗАЦИЯ РЕЗУЛЬТАТОВ КЛАСТЕРИЗАЦИИ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 5: ВИЗУАЛИЗАЦИЯ РЕЗУЛЬТАТОВ КЛАСТЕРИЗАЦИИ")
print("="*80)

# Создание графиков для каждого метода
methods = [
    ('KMeans', kmeans_labels, 'viridis'),
    ('DBSCAN', dbscan_labels, 'plasma'),
    ('Agglomerative', agglomerative_labels, 'turbo')
]

fig = plt.figure(figsize=(18, 12))

# 2D визуализация
for idx, (name, labels, cmap) in enumerate(methods, 1):
    ax = fig.add_subplot(2, 3, idx)
    
    if name == 'DBSCAN':
        # Отдельно отображаем шум
        noise_mask = labels == -1
        cluster_mask = ~noise_mask
        
        if np.any(noise_mask):
            ax.scatter(X_pca_2d[noise_mask, 0], X_pca_2d[noise_mask, 1],
                      c='gray', s=10, alpha=0.3, label='Шум', edgecolor='k', linewidth=0.2)
        
        if np.any(cluster_mask):
            scatter = ax.scatter(X_pca_2d[cluster_mask, 0], X_pca_2d[cluster_mask, 1],
                                c=labels[cluster_mask], cmap=cmap, s=15, alpha=0.6,
                                edgecolor='k', linewidth=0.2)
            plt.colorbar(scatter, ax=ax, label='Номер кластера')
    else:
        scatter = ax.scatter(X_pca_2d[:, 0], X_pca_2d[:, 1], c=labels,
                            cmap=cmap, s=15, alpha=0.6, edgecolor='k', linewidth=0.2)
        plt.colorbar(scatter, ax=ax, label='Номер кластера')
    
    ax.set_xlabel('Первая главная компонента')
    ax.set_ylabel('Вторая главная компонента')
    ax.set_title(f'Кластеризация методом {name} (2D проекция)')

# 3D визуализация
from mpl_toolkits.mplot3d import Axes3D

for idx, (name, labels, cmap) in enumerate(methods, 4):
    ax = fig.add_subplot(2, 3, idx, projection='3d')
    
    if name == 'DBSCAN':
        noise_mask = labels == -1
        cluster_mask = ~noise_mask
        
        if np.any(noise_mask):
            ax.scatter(X_pca_3d[noise_mask, 0], X_pca_3d[noise_mask, 1], X_pca_3d[noise_mask, 2],
                      c='gray', s=5, alpha=0.2, label='Шум', depthshade=True)
        
        if np.any(cluster_mask):
            scatter = ax.scatter(X_pca_3d[cluster_mask, 0], X_pca_3d[cluster_mask, 1], X_pca_3d[cluster_mask, 2],
                                c=labels[cluster_mask], cmap=cmap, s=8, alpha=0.6, depthshade=True)
    else:
        scatter = ax.scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], X_pca_3d[:, 2],
                            c=labels, cmap=cmap, s=8, alpha=0.6, depthshade=True)
    
    ax.set_xlabel('Компонента 1')
    ax.set_ylabel('Компонента 2')
    ax.set_zlabel('Компонента 3')
    ax.set_title(f'Кластеризация методом {name} (3D проекция)')

plt.tight_layout()
plt.show()

# ============================================================================
# 6. ОЦЕНКА КАЧЕСТВА КЛАСТЕРИЗАЦИИ
# ============================================================================

print("\n" + "="*80)
print("ЭТАП 6: ОЦЕНКА КАЧЕСТВА КЛАСТЕРИЗАЦИИ")
print("="*80)

# Внутренние метрики качества
print("\nВНУТРЕННИЕ МЕТРИКИ КАЧЕСТВА КЛАСТЕРИЗАЦИИ:")
print("-" * 60)

metrics_data = []
methods_info = [
    ('KMeans', kmeans_labels, X_scaled),
    ('DBSCAN', dbscan_labels, X_scaled),
    ('Agglomerative', agglomerative_labels, X_scaled)
]

for name, labels, data in methods_info:
    if name == 'DBSCAN':
        valid_mask = labels != -1
        n_clusters = len(np.unique(labels[valid_mask]))
        
        if n_clusters > 1 and np.sum(valid_mask) > 1:
            silhouette = silhouette_score(data[valid_mask], labels[valid_mask])
            calinski = calinski_harabasz_score(data[valid_mask], labels[valid_mask])
            davies = davies_bouldin_score(data[valid_mask], labels[valid_mask])
        else:
            silhouette = calinski = davies = np.nan
    else:
        n_clusters = len(np.unique(labels))
        silhouette = silhouette_score(data, labels)
        calinski = calinski_harabasz_score(data, labels)
        davies = davies_bouldin_score(data, labels)
    
    metrics_data.append({
        'Метод': name,
        'Кластеры': n_clusters,
        'Силуэт': silhouette,
        'Калински-Харабас': calinski,
        'Дэвис-Болдуин': davies
    })

metrics_df = pd.DataFrame(metrics_data)
print(metrics_df.to_string(index=False, float_format=lambda x: f'{x:.3f}' if not pd.isna(x) else 'N/A'))

# Сравнение с истинными метками (рейтинг, преобразованный в классы)
print("\nСРАВНЕНИЕ С ИСТИННЫМИ МЕТКАМИ (КЛАССЫ РЕЙТИНГА):")
print("-" * 60)

true_labels = df_clean['rating_class_encoded']

comparison_results = []
for name, labels in [('KMeans', kmeans_labels), ('Agglomerative', agglomerative_labels)]:
    ari = adjusted_rand_score(true_labels, labels)
    nmi = normalized_mutual_info_score(true_labels, labels)
    
    comparison_results.append({
        'Метод': name,
        'Adjusted Rand Index': ari,
        'Normalized Mutual Info': nmi
    })

# Для DBSCAN исключаем шумовые точки
dbscan_valid_mask = dbscan_labels != -1
if np.sum(dbscan_valid_mask) > 0:
    dbscan_ari = adjusted_rand_score(true_labels[dbscan_valid_mask], dbscan_labels[dbscan_valid_mask])
    dbscan_nmi = normalized_mutual_info_score(true_labels[dbscan_valid_mask], dbscan_labels[dbscan_valid_mask])
    
    comparison_results.append({
        'Метод': 'DBSCAN (без шума)',
        'Adjusted Rand Index': dbscan_ari,
        'Normalized Mutual Info': dbscan_nmi
    })

comparison_df = pd.DataFrame(comparison_results)
print(comparison_df.to_string(index=False, float_format=lambda x: f'{x:.4f}'))

# ============================================================================
# 7. ИНТЕРПРЕТАЦИЯ КЛАСТЕРОВ (НА ПРИМЕРЕ KMEANS)
# ============================================================================

